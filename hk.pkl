// Хуки ставит `hk install`: на git 2.54+ это записи hook.* в .git/config,
// общий core.hooksPath дерева кита они не трогают.
amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

// Быстрые проверки идут на каждый коммит. Сеть и долгие шаги вынесены в all:
// их гоняют check, pre-push и CI.
local fast = new Mapping<String, Step> {
  ["rumdl"] = Builtins.rumdl
  ["typos"] = Builtins.typos
  ["jactionlint"] = Builtins.jactionlint
  ["oxfmt"] {
    glob = List("**/*.ts", "**/*.html", "**/*.css", "**/*.json")
    exclude = List("package-lock.json")
    check = "npx oxfmt --check {{files}}"
    fix = "npx oxfmt {{files}}"
  }
  // Oxlint по умолчанию выходит с 0 на предупреждениях.
  ["oxlint"] {
    glob = List("**/*.ts")
    check = "npx oxlint --deny-warnings {{files}}"
  }
  ["tsc"] {
    glob = List("**/*.ts", "tsconfig.json")
    check = "npx tsc --noEmit"
  }
}

local all = (fast) {
  ["knip"] {
    check = "npx knip"
  }
  ["osv-scanner"] {
    glob = List("package-lock.json")
    check = "osv-scanner scan --lockfile package-lock.json"
  }
  ["lychee"] {
    glob = List("**/*.md")
    check = "lychee --config lychee.toml --no-progress {{files}}"
  }
}

hooks {
  // stash выключен: на время хука он откатывает непроиндексированные файлы
  // рабочего дерева, в том числе чужие правки параллельной сессии.
  ["pre-commit"] {
    fix = true
    stash = "none"
    steps = fast
  }
  // История читается release-please, а коммиты идут прямо в main, поэтому
  // заголовок проверяется до записи. В CI тот же commitlint гоняется по
  // диапазону пуша.
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] { steps = all }
  ["fix"] {
    fix = true
    steps = all
  }
}
